<Window x:Class="TypeEasy.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TypeEasy.Windows" Title="ShelterType" Width="1200" Height="900" MinWidth="960" MinHeight="760" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_Key">
 <Grid x:Name="RootLayout" Margin="24,16">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="SidebarButton" Click="Sidebar_Click" Style="{StaticResource ToolbarIconButton}" Margin="0,0,16,0"><local:AppIcon x:Name="SidebarIcon" Kind="SidebarOpen"/></Button><local:BrandMark x:Name="BrandLogo" Width="34" Height="34" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="BrandLabel" Text="ShelterType" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><StackPanel x:Name="NavigationActions" Orientation="Horizontal"><Button x:Name="SpeedButton" Click="Speed_Click" Style="{StaticResource ToolbarIconButton}" Margin="0,0,8,0"><local:AppIcon Kind="SpeedTest"/></Button><Button x:Name="StatisticsButton" Click="Statistics_Click" Style="{StaticResource ToolbarIconButton}" Margin="0,0,8,0"><local:AppIcon Kind="Statistics"/></Button></StackPanel><Button x:Name="FocusButton" Click="Focus_Click" Style="{StaticResource ToolbarIconButton}" Margin="0,0,8,0"><local:AppIcon x:Name="FocusIcon" Kind="Focus"/></Button><Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource ToolbarIconButton}"><local:AppIcon Kind="Settings"/></Button></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260"/><ColumnDefinition x:Name="SidebarGap" Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="{DynamicResource Panel}" CornerRadius="10" Padding="14"><DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <UniformGrid Columns="3" Margin="0,0,0,12"><Button x:Name="EnglishTab" Content="英文" Tag="英文" Click="Category_Click" Padding="8,8" Margin="0,0,4,0"/><Button x:Name="ChineseTab" Content="拼音" Tag="中文" Click="Category_Click" Padding="8,8" Margin="0,0,4,0"/><Button x:Name="WubiTab" Content="五笔" Tag="五笔" Click="Category_Click" Padding="8,8"/></UniformGrid>
     <Grid Margin="0,0,0,10"><TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="搜索课程"/><TextBlock x:Name="SearchPlaceholder" Text="搜索课程" Foreground="{DynamicResource Muted}" Margin="11,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Button x:Name="DictionaryButton" Content="五笔86词典  F2" Click="Dictionary_Click" Margin="0,0,0,8"/><Button x:Name="PersonalPracticeButton" Content="专属练习" Click="PersonalPractice_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10" Padding="10,7"/>
    </StackPanel>
    <TreeView x:Name="CourseTree" SelectedItemChanged="Course_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
      <Grid ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding AccessibleName}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ProgressVisibility}">
        <TextBlock Text="{Binding PercentText}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <local:CourseProgressIndicator Status="{Binding Progress.Status}" Fraction="{Binding Progress.Fraction}"/>
       </StackPanel>
      </Grid>
     </HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   </DockPanel></Border>
   <Grid Grid.Column="2" x:Name="PracticeLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><Button x:Name="RestartCourseButton" DockPanel.Dock="Right" Content="重新练习" Click="RestartCourse_Click" Visibility="Collapsed" Margin="12,0,0,0"/><StackPanel><TextBlock x:Name="CourseTitle" Text="载入课程…" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CourseSubtitle" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="20,14"><ScrollViewer x:Name="ExerciseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Top">
     <Grid><TextBlock x:Name="PositionLabel" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="SaveLabel" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid>
     <ScrollViewer x:Name="LessonScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10"><StackPanel VerticalAlignment="Top"><DockPanel><Image x:Name="LessonImage" Height="56" MaxWidth="420" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,12,0" Visibility="Collapsed"/><TextBlock x:Name="PromptLabel" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/></DockPanel><TextBlock x:Name="ExpectedLabel" FontFamily="Microsoft YaHei UI" FontSize="25" TextWrapping="Wrap"/><TextBlock x:Name="NextLabel" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></ScrollViewer>
     <StackPanel><TextBox x:Name="InputBox" Height="46" FontSize="22" AutomationProperties.Name="练习输入框" PreviewTextInput="Input_Text" PreviewKeyDown="Input_Key" GotKeyboardFocus="Input_Focus" LostKeyboardFocus="Input_Blur" IsUndoEnabled="False" ContextMenu="{x:Null}"/><TextBlock x:Name="FeedbackLabel" Foreground="{DynamicResource Error}" FontSize="12" MinHeight="18" Margin="0,4,0,2" TextWrapping="Wrap"/></StackPanel>
     <StackPanel x:Name="KeyboardPanel" Margin="0,4,0,6"><local:TeachingKeyboard x:Name="KeyboardGuide" MaxWidth="780"/></StackPanel>
     <Grid Height="3" Background="{DynamicResource Field}"><Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="2" Width="0"/></Grid>
    </StackPanel></ScrollViewer></Border>
    <TextBlock x:Name="StatsLabel" Grid.Row="2" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0"/>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2">
   <Border x:Name="UpdateNotice" Visibility="Collapsed" Background="{DynamicResource Selected}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
    <DockPanel LastChildFill="True">
     <Button x:Name="DismissUpdateButton" DockPanel.Dock="Right" Click="DismissUpdate_Click" Padding="10,5" Margin="8,0,0,0"/>
     <Button x:Name="OpenUpdateButton" DockPanel.Dock="Right" Click="OpenUpdate_Click" Padding="10,5"/>
     <TextBlock x:Name="UpdateNoticeText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
    </DockPanel>
   </Border>
   <TextBlock x:Name="StatusLabel" Visibility="Collapsed" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>
